<?xml version="1.0" encoding="utf-8"?>
<!-- A fixed-size circle in the middle of the day cell, so it stays round
     whatever the cell's aspect ratio. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="22dp" android:height="22dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/widgetPrimaryContainer" />
            
        </shape>
    </item>
</layer-list>
