<?xml version="1.0" encoding="utf-8"?>
<!-- A fixed-size circle in the middle of the day cell, so it stays round
     whatever the cell's aspect ratio. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="18dp" android:height="18dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/widgetToday" />
            <stroke android:width="1.5dp" android:color="@color/widgetTodayRing" />
        </shape>
    </item>
</layer-list>
